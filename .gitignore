# Build output (regenerated by `dotnet build` / `dotnet publish`)
bin/
obj/

# Visual Studio / VS Code user-specific files
.vs/
.vscode/
*.user
*.suo

# Claude Code CLI runtime state (session locks, not part of the project)
.claude/

# Runtime state and logs this project itself writes at runtime -- never
# checked in, and should never appear here since production paths are
# %LOCALAPPDATA%\ClaudeTabNotifier(POC)\ and ~/.claude/tools/, both outside
# this repo. Defensive patterns in case any test or manual run ever writes
# alongside the source by mistake.
*.log
*.log.old
install-manifest.json
*.backup-*
_heartbeat_*.txt
_watcherlog_*.txt
_latest_session.txt
_cleanup.log

# OS cruft
Thumbs.db
desktop.ini
